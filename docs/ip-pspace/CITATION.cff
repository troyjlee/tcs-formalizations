preferred-citation:
  type: software
  title: "TCS formalizations: sunflowers, the metric TSP integrality gap, and IP = PSPACE"
  authors:
    - family-names: Lee
      given-names: Troy
      orcid: "https://orcid.org/0000-0001-6912-2338"
