import PCP.Complexity.LangSeedDecode

/-!
# Stored fixed-width base digits from one numeric address

The radix list is generated by a counted loop, then passed to the proved mixed
radix decoder. Source register zero is the code, one the width, and two the base.
-/

namespace PCP.Lang.UniformRadix

def fill : Stmt 5 2 := .loop 1 (.push 0 2)

theorem iterate_fill (c k : ℕ) (st : State 5 2) :
    (iterate (Stmt.push 0 2).run c k st).1.regs = st.regs ∧
    (iterate (Stmt.push 0 2).run c k st).1.lists 0 =
      List.replicate k (st.regs 2) ++ st.lists 0 ∧
    (iterate (Stmt.push 0 2).run c k st).1.lists 1 = st.lists 1 ∧
    (iterate (Stmt.push 0 2).run c k st).2 = k * (c + Nat.size (st.regs 2) + 1) := by
  induction k generalizing st with
  | zero => simp [iterate]
  | succ k ih =>
      obtain ⟨hr, h0, h1, hc⟩ := ih ((Stmt.push 0 2).run st).1
      simp only [iterate, Stmt.run, setList, Function.update_self] at hr h0 h1 hc ⊢
      refine ⟨hr, ?_, ?_, ?_⟩
      · rw [h0]
        rw [List.replicate_succ']
        simp only [List.append_assoc, List.singleton_append]
      · simpa [Function.update] using h1
      · rw [hc, Nat.succ_mul]
        omega

theorem fill_run (st : State 5 2) :
    (fill.run st).1.regs = st.regs ∧
    (fill.run st).1.lists 0 = List.replicate (st.regs 1) (st.regs 2) ++ st.lists 0 ∧
    (fill.run st).1.lists 1 = st.lists 1 := by
  have h := iterate_fill (Nat.size (st.regs 1) + 1) (st.regs 1) st
  exact ⟨h.1, h.2.1, h.2.2.1⟩

theorem fill_cost (st : State 5 2) :
    (fill.run st).2 = st.regs 1 * (Nat.size (st.regs 1) + Nat.size (st.regs 2) + 2) +
      Nat.size (st.regs 1) + 1 := by
  change (iterate (Stmt.push 0 2).run (Nat.size (st.regs 1) + 1) (st.regs 1) st).2 +
    Nat.size (st.regs 1) + 1 = _
  rw [(iterate_fill (Nat.size (st.regs 1) + 1) (st.regs 1) st).2.2.2]
  have he : Nat.size (st.regs 1) + 1 + Nat.size (st.regs 2) + 1 =
      Nat.size (st.regs 1) + Nat.size (st.regs 2) + 2 := by omega
  rw [he]

def program : Stmt 5 2 := .seq fill MixedRadixDecode.program

/-- Exact little-endian digits, including every leading zero coordinate. -/
theorem program_run (st : State 5 2) (h0 : st.lists 0 = []) (h1 : st.lists 1 = []) :
    (program.run st).1.lists 1 =
      (MixedRadixDecode.split (st.regs 0) (List.replicate (st.regs 1) (st.regs 2))).1 ∧
    (program.run st).1.lists 0 = [] := by
  have hfill := fill_run st
  have hdec := MixedRadixDecode.program_run (fill.run st).1
  simp only [program, run_seq_fst]
  refine ⟨?_, hdec.2.1⟩
  simpa only [hfill.1, hfill.2.1, hfill.2.2, h0, h1, List.append_nil,
    List.reverse_nil, List.nil_append] using hdec.2.2

/-- Runtime digits agree with the production finite-function codec. -/
theorem program_finFunction (base n : ℕ) (code : Fin (base ^ n))
    (st : State 5 2) (hc : st.regs 0 = code.val) (hn : st.regs 1 = n)
    (hb : st.regs 2 = base) (h0 : st.lists 0 = []) (h1 : st.lists 1 = []) :
    (program.run st).1.lists 1 =
      List.ofFn (fun i : Fin n => ((finFunctionFinEquiv.symm code) i).val) := by
  rw [(program_run st h0 h1).1, hc, hn, hb, MixedRadixDecode.split_finFunction]

/-- Uniform decoding has polynomial charged cost in the width and numeric bit sizes. -/
theorem program_cost (st : State 5 2) (h0 : st.lists 0 = []) (h1 : st.lists 1 = []) :
    (program.run st).2 ≤ (MixedRadixDecode.passConstant + 20) *
      (st.regs 1 + Nat.size (st.regs 2) + Nat.size (st.regs 0) + 2) ^ 4 := by
  let M := st.regs 1 + Nat.size (st.regs 2) + Nat.size (st.regs 0) + 2
  have hm : 1 ≤ M := by dsimp [M]; omega
  have hfill := fill_run st
  have hdec := MixedRadixDecode.program_cost (fill.run st).1
  have hlen : listSize ((fill.run st).1.lists 0) = st.regs 1 * (Nat.size (st.regs 2) + 1) := by
    simp [hfill.2.1, h0, listSize]
  have hout : listSize ((fill.run st).1.lists 1) = 0 := by simp [hfill.2.2, h1, listSize]
  have hsmall : Nat.size (st.regs 1) ≤ st.regs 1 := size_le_self _
  have hbase : st.regs 1 * (Nat.size (st.regs 2) + 1) + Nat.size (st.regs 0) + 2 ≤ M ^ 2 := by
    dsimp [M]
    nlinarith
  have hp := Nat.pow_le_pow_left hbase 2
  have hm24 : M ^ 2 ≤ M ^ 4 := Nat.pow_le_pow_right hm (by decide)
  simp only [hfill.1, hlen, hout, Nat.add_zero] at hdec
  have hdc : (MixedRadixDecode.program.run (fill.run st).1).2 ≤
      (MixedRadixDecode.passConstant + 12) * M ^ 4 := by
    have hh := Nat.mul_le_mul_left (MixedRadixDecode.passConstant + 12) hp
    simpa only [← pow_mul] using hdec.trans hh
  have hf : (fill.run st).2 ≤ 3 * M ^ 2 := by
    rw [fill_cost]
    dsimp [M]
    nlinarith
  rw [program, run_seq_snd]
  change (fill.run st).2 + (MixedRadixDecode.program.run (fill.run st).1).2 + 1 ≤
    (MixedRadixDecode.passConstant + 20) * M ^ 4
  have hpos : 1 ≤ M ^ 4 := Nat.one_le_pow _ _ hm
  nlinarith only [hf, hdc, hm24, hpos]

end PCP.Lang.UniformRadix
