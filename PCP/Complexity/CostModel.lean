import PCP.Verifier.Definition
import Mathlib.Computability.Partrec

/-!
# Verifier algorithms and the cost-model interface

`VerifierAlg` specifies the next step of an adaptive bit verifier. `ImplementedBy`
ties that algorithm to the semantic query tree. The concrete implementation uses
finite Turing machines; `CostModel` packages the closure properties used by the
reverse PCP inclusion. `PCP.Complexity.StandardModel` proves those properties
for the concrete machine model.
-/

namespace PCP

/-- One step of an adaptive verifier algorithm.

`alg x r as` is given the input `x`, the random string `r` as a bit list, and the answer bits
received so far (oldest first). It returns either `.inl b`, halting with decision `b`, or
`.inr a`, naming the next proof address to query.

This is the algorithmic counterpart of `QueryTree`: a decision tree is what the algorithm *does*,
this is the algorithm itself, and a cost model measures the latter. -/
abbrev VerifierAlg : Type := List Bool → List Bool → List Bool → Bool ⊕ ℕ

/-- The `k`-bit binary expansion of a random string index, least significant bit first. -/
def bitsOfFin (k : ℕ) (r : Fin (2 ^ k)) : List Bool :=
  (List.range k).map (fun j => r.val.testBit j)

@[simp] theorem length_bitsOfFin (k : ℕ) (r : Fin (2 ^ k)) : (bitsOfFin k r).length = k := by
  simp [bitsOfFin]

namespace QueryTree

/-- The depth-`d` decision tree generated by unfolding a step function, starting from the answers
`as` received so far.

If the step function has not halted within its `d`-query budget the tree rejects: an algorithm
claiming a `q`-query verifier must halt within `q` queries, and `ImplementedBy` below is what
forces that to match the verifier's actual behaviour. -/
def ofStep (f : List Bool → Bool ⊕ ℕ) : (d : ℕ) → List Bool → QueryTree d
  | 0, as => match f as with
      | .inl b => .leaf b
      | .inr _ => .leaf false
  | _ + 1, as => match f as with
      | .inl b => .leaf b
      | .inr addr => .query addr (ofStep f _ (as ++ [false])) (ofStep f _ (as ++ [true]))

theorem ofStep_zero (f : List Bool → Bool ⊕ ℕ) (as : List Bool) :
    ofStep f 0 as = match f as with | .inl b => .leaf b | .inr _ => .leaf false := rfl

end QueryTree

namespace Verifier

/-- `alg` implements `V`: unfolding the algorithm reproduces `V`'s decision tree on every input and
every random string.

This ties the certificate to *this* verifier — its random-bit handling (`bitsOfFin`), its query
addresses, and its decision rule all have to match. Proving some unrelated verifier efficient
would not discharge it. -/
def ImplementedBy (V : Verifier) (alg : VerifierAlg) : Prop :=
  ∀ (x : List Bool) (r : Fin (2 ^ V.randomness x.length)),
    QueryTree.ofStep (alg x (bitsOfFin (V.randomness x.length) r)) V.queries [] = V.run x r

end Verifier

/-- A uniform cost model: what "polynomial time" means for witness-checking relations and for
verifier algorithms, together with the coherence and closure properties any genuine model has.

The field docstrings explain why each field is present. **The machine model is no longer a choice**:
`PCP/Complexity/Machine.lean` fixes it as `Turing.TM2ComputableInPolyTime`. Showing those concrete
predicates satisfy this interface was obligation NP-1, now discharged: the two coherence fields in
`PCP/Complexity/Bridge.lean`, the closure field below in `PCP/Complexity/StandardModel.lean`.
Note the known cost of that choice: *some* certified composition or subroutine result is needed for
the closure field, and mathlib's `comp` is an open `proof_wanted` at the pinned revision. That
upstream theorem is one route; a specialised call-and-return construction for these fixed encodings
is another, and is the one that was built. -/
structure CostModel where
  /-- Binary relations on bit strings decidable in polynomial time. -/
  PolyTimeRel : (List Bool → List Bool → Bool) → Prop
  /-- Verifier algorithms running in polynomial time. -/
  PolyTimeAlg : VerifierAlg → Prop
  /-- Soundness: a polynomial-time relation is computable. -/
  polyTimeRel_computable : ∀ R, PolyTimeRel R → Computable₂ R
  /-- Soundness: a polynomial-time verifier algorithm is computable.  This rules out a degenerate
  model that counts an arbitrary, even noncomputable, step function as efficient; such a model
  would let a "verifier" decide the language outright. -/
  polyTimeAlg_computable : ∀ alg : VerifierAlg, PolyTimeAlg alg →
    Computable (fun t : List Bool × List Bool × List Bool => alg t.1 t.2.1 t.2.2)
  /-- Closure: an efficiently implemented verifier with logarithmic randomness and a polynomial
  proof-length bound induces a polynomial-time NP checking relation.

  This is the bridge between verifier efficiency and NP-checker efficiency.
  Discharging it means showing the model is closed under: enumerating `2 ^ O(log n)` random
  strings, unfolding a constant-depth query tree, and indexing a polynomially long witness.

  The budget hypothesis is `CanonicalRandomness`, **not** `LogRandomness`.  With only an upper
  bound this field is not justifiable for any standard model: an arbitrary `f : ℕ → Bool` can be
  hidden in the budget (see `Verifier.LogRandomness`) and recovered by an elementary
  length-measuring algorithm, so the field would assert that every unary language has a computable
  checking relation.  A canonical budget is determined by `a` and `b` and carries no such
  information. -/
  polyTimeRel_finiteWitnessCheck :
    ∀ (V : Verifier) (alg : VerifierAlg) (a b : ℕ) (p : Polynomial ℕ),
      PolyTimeAlg alg → V.ImplementedBy alg → V.CanonicalRandomness a b →
      (∀ x : List Bool, V.ReadsBelow x (p.eval x.length)) →
      PolyTimeRel (finiteWitnessCheck V)

namespace CostModel

variable (M : CostModel)

/-- `V` is efficiently implementable in the model `M`. -/
def Efficient (V : Verifier) : Prop := ∃ alg : VerifierAlg, M.PolyTimeAlg alg ∧ V.ImplementedBy alg

end CostModel



end PCP
