import PCP.Reduction.BooleanClauseArithmetic
import PCP.Complexity.ArithmeticFiniteLookup

/-!
# Stored fixed-arity Boolean constraint tables

Each record stores a fixed truth table followed by its scope indices. The format
is read using arithmetic addresses. Boolean-pattern bits are a table fixed by
arity, not an input-dependent enumeration.
-/

namespace PCP.Reduction.BooleanClauseSource

open NAEThreeColor FiniteBooleanConstraints

variable {v c k : ℕ}

def width (k : ℕ) : ℕ := 2 ^ k + k

def record (relation : Fin c → Pattern k → Bool) (scope : Fin c → Fin k → Fin v)
    (e : Fin c) (i : Fin (width k)) : ℕ :=
  if hp : i.val < 2 ^ k then
    (relation e ((FiniteBooleanEncoding.patternCode k).symm ⟨i.val, hp⟩)).toNat
  else (scope e ⟨i.val - 2 ^ k, by have := i.isLt; dsimp [width] at *; omega⟩).val

def source (relation : Fin c → Pattern k → Bool) (scope : Fin c → Fin k → Fin v) : List ℕ :=
  v :: c :: List.ofFn (fun j : Fin (c * width k) =>
    record relation scope (finProdFinEquiv.symm j).1 (finProdFinEquiv.symm j).2)

def scope (input : List ℕ) (k e i : ℕ) : ℕ :=
  input.getD (2 + (e * width k + (2 ^ k + i))) 0

def relation (input : List ℕ) (k e p : ℕ) : ℕ := input.getD (2 + (e * width k + p)) 0

def patternTable (k : ℕ) : List ℕ :=
  List.ofFn (fun j : Fin (2 ^ k * k) =>
    (((FiniteBooleanEncoding.patternCode k).symm (finProdFinEquiv.symm j).1)
      (finProdFinEquiv.symm j).2).toNat)

def pattern (k p i : ℕ) : ℕ := (patternTable k).getD (p * k + i) 0

theorem pattern_correct (p : Pattern k) (i : Fin k) :
    pattern k (FiniteBooleanEncoding.patternCode k p).val i.val = (p i).toNat := by
  let j := finProdFinEquiv (FiniteBooleanEncoding.patternCode k p, i)
  have hj : j.val = (FiniteBooleanEncoding.patternCode k p).val * k + i.val := by
    simp [j, finProdFinEquiv, Nat.mul_comm, Nat.add_comm]
  simp only [pattern, ← hj, patternTable, List.getD_eq_getElem?_getD, List.getElem?_ofFn,
    dite_eq_left j.isLt, Option.getD_some]
  have hm : (⟨j.val, j.isLt⟩ : Fin (2 ^ k * k)) = j := rfl
  rw [hm]
  simp [j]

theorem source_relation (R : Fin c → Pattern k → Bool) (s : Fin c → Fin k → Fin v)
    (e : Fin c) (p : Pattern k) :
    relation (source R s) k e.val (FiniteBooleanEncoding.patternCode k p).val = (R e p).toNat := by
  let pi : Fin (width k) := ⟨(FiniteBooleanEncoding.patternCode k p).val,
    lt_of_lt_of_le (FiniteBooleanEncoding.patternCode k p).isLt (by dsimp [width]; omega)⟩
  let j := finProdFinEquiv (e, pi)
  have hj : j.val = e.val * width k + (FiniteBooleanEncoding.patternCode k p).val := by
    simp [j, pi, finProdFinEquiv, Nat.mul_comm, Nat.add_comm]
  simp only [relation, ← hj, source, List.getD_eq_getElem?_getD]
  rw [show 2 + j.val = j.val + 2 by omega]
  simp only [List.getElem?_cons_succ, List.getElem?_ofFn, dite_eq_left j.isLt, Option.getD_some]
  change record R s (finProdFinEquiv.symm j).1 (finProdFinEquiv.symm j).2 = _
  rw [show finProdFinEquiv.symm j = (e, pi) from Equiv.symm_apply_apply _ _]
  simp [record, pi]

theorem source_scope (R : Fin c → Pattern k → Bool) (s : Fin c → Fin k → Fin v)
    (e : Fin c) (i : Fin k) : scope (source R s) k e.val i.val = (s e i).val := by
  let pi : Fin (width k) := ⟨2 ^ k + i.val, by dsimp [width]; omega⟩
  let j := finProdFinEquiv (e, pi)
  have hj : j.val = e.val * width k + (2 ^ k + i.val) := by
    simp [j, pi, finProdFinEquiv, Nat.mul_comm, Nat.add_comm]
  simp only [scope, ← hj, source, List.getD_eq_getElem?_getD]
  rw [show 2 + j.val = j.val + 2 by omega]
  simp only [List.getElem?_cons_succ, List.getElem?_ofFn, dite_eq_left j.isLt, Option.getD_some]
  change record R s (finProdFinEquiv.symm j).1 (finProdFinEquiv.symm j).2 = _
  rw [show finProdFinEquiv.symm j = (e, pi) from Equiv.symm_apply_apply _ _]
  simp [record, pi]

/-- Natural decoding of the exact ternary formula generated by the Boolean compiler. -/
theorem address_correct (R : Fin c → Pattern k → Bool) (s : Fin c → Fin k → Fin v)
    (j : Fin (c * 2 ^ k * (3 * k + 2))) (i : Fin 3) :
    BooleanClauseArithmetic.address v k j.val i.val (scope (source R s) k) (pattern k)
        (relation (source R s) k) =
      ThreeColorNumericAdjacency.literalAddress (FiniteBooleanEncoding.indexedClauses R s j i) :=
  BooleanClauseArithmetic.address_correct R s _ _ _ (source_scope R s)
    pattern_correct (source_relation R s) j i

/-- The finite pattern lookup is realized as arithmetic syntax with a fixed table. -/
def patternTerm {n : ℕ} (k : ℕ) (p i : PCP.Lang.ArithmeticExpression.Term n) :
    PCP.Lang.ArithmeticExpression.Term n :=
  .table (patternTable k) (.bin .add (.bin .mul p (.const k)) i)

theorem patternTerm_eval {n : ℕ} (k : ℕ) (p i : PCP.Lang.ArithmeticExpression.Term n)
    (r : Fin n → ℕ) :
    (patternTerm k p i).eval r = pattern k (p.eval r) (i.eval r) := by
  simp [patternTerm, PCP.Lang.ArithmeticExpression.Term.eval,
    PCP.Lang.ArithmeticExpression.Op.eval, pattern]

@[simp] theorem source_length (R : Fin c → Pattern k → Bool) (s : Fin c → Fin k → Fin v) :
    (source R s).length = 2 + c * width k := by simp [source]; omega

end PCP.Reduction.BooleanClauseSource
